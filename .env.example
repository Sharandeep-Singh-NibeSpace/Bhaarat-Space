# bharatenv — Bharat Space environment template
# Copy to .env.local for local dev. On Vercel, add the same keys in
# Project Settings → Environment Variables (Production, Preview, Development).

# Optional. Web3Forms access key for contact form email delivery.
# Get one at https://web3forms.com — without it, the API falls back to FormSubmit.
WEB3FORMS_ACCESS_KEY=

# Inbox that receives contact form messages (FormSubmit fallback).
CONTACT_TO_EMAIL=info@bharatspace.co

# Secret key for /admin/inquiries?key=YOUR_SECRET
# Required on Vercel. Generate a long random string and keep it private.
INQUIRIES_SECRET=

# Hero earth video. Default on Vercel is the smaller file so deploys stay under
# static-upload limits. For local 4K, set these in .env.local.
NEXT_PUBLIC_HERO_VIDEO=/videos/earth_bg.mp4
NEXT_PUBLIC_HERO_POSTER=/videos/posters/earth_bg.jpg

# VPS only. Leave this unset for local dev and for Vercel so the site stays at /.
# deploy/deploy-bharat.sh sets it to /Bharat on the server before the build.
# NEXT_PUBLIC_BASE_PATH=
